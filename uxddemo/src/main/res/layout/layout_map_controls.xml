<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_map_controls"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="12dp"
    tools:background="#888888">

    <androidx.cardview.widget.CardView
        android:id="@+id/view_panel_background"
        android:layout_width="70dp"
        android:layout_height="0dp"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="-4dp"
        app:cardBackgroundColor="#66000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_map_focus_drone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_map_layers" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_map_layers"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_settings_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFCC00" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_map_orientation"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_assistant_navigation_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_map_layers"
        app:tint="#FFFFFF"
        tools:src="@drawable/outline_assistant_navigation_24" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_map_tracking_menu"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_file_map_stack_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_map_orientation"
        app:tint="#FFFFFF" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_map_focus_drone"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/outline_moved_location_24"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_map_tracking_menu"
        app:tint="#00FF00"
        tools:visibility="visible" />

    <androidx.cardview.widget.CardView
        android:id="@+id/ll_submenu_layers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#88000000"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_map_layers"
        app:layout_constraintEnd_toStartOf="@+id/view_panel_background"
        app:layout_constraintTop_toTopOf="@+id/btn_map_layers"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_map_normal"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:backgroundTint="#666666"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Схема"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_map_hybrid"
                android:layout_width="90dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#666666"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Гибрид"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/ll_submenu_tracking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#88000000"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_map_tracking_menu"
        app:layout_constraintEnd_toStartOf="@+id/view_panel_background"
        app:layout_constraintTop_toTopOf="@+id/btn_map_tracking_menu"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_track_rc"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="#00000000"
                android:contentDescription="Пульт"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/common_ic_stance_remote" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_track_home"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="6dp"
                android:background="#00000000"
                android:contentDescription="Дом"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/common_ic_ball_home" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_track_drone"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginStart="6dp"
                android:background="#00000000"
                android:contentDescription="Дрон"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/common_ic_ball_drone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>